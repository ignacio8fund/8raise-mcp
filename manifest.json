{
  "$schema": "https://modelcontextprotocol.io/schemas/manifest.json",
  "name": "8Raise",
  "version": "1.1.0",
  "description": "Find investors for your startup, fund or real estate deal. 8Raise searches our own investor database of VCs, LPs, family offices, angels and US wealth advisers and returns ready-to-contact investors (names, titles, firms, LinkedIn profiles, emails and fund data) directly inside your AI assistant. Also: enrich a firm list, Lookalike investors and Firm Finder.",
  "homepage": "https://8raise.com",
  "documentation": "https://8raise.com/connect",
  "support": "hi@8raise.com",
  "license": "MIT",
  "publisher": {
    "name": "8Raise",
    "url": "https://8raise.com"
  },
  "server": {
    "type": "remote",
    "url": "https://mcp.8raise.com/mcp",
    "transport": "streamable-http"
  },
  "auth": {
    "type": "oauth2",
    "flow": "authorization_code_pkce",
    "discovery_url": "https://mcp.8raise.com/.well-known/oauth-authorization-server",
    "scopes": [
      "openid",
      "profile",
      "email",
      "mcp"
    ]
  },
  "categories": [
    "business",
    "lead-generation",
    "venture-capital",
    "fundraising"
  ],
  "tags": [
    "investors",
    "vc",
    "lp",
    "family-offices",
    "ria",
    "real-estate",
    "fundraising",
    "leads",
    "outreach"
  ],
  "tools": [
    "get_started",
    "refine_query",
    "search_investors",
    "check_search_status",
    "list_advanced_options",
    "enrich_companies",
    "check_enrichment_status",
    "discover_investors",
    "find_firms",
    "check_discovery_status",
    "approve_discovery",
    "search_tips",
    "upload_exclusion_list",
    "export_results",
    "import_linkedin_connections",
    "get_usage",
    "manage_subscription",
    "get_billing_info",
    "save_lead",
    "list_saved_leads",
    "unsave_lead",
    "tag_lead",
    "save_search",
    "list_saved_searches",
    "rerun_search",
    "delete_saved_search",
    "list_outreach_destinations",
    "send_to_heyreach"
  ],
  "privacy_policy": "https://8raise.com/privacy",
  "terms_of_service": "https://8raise.com/terms"
}
